    if(st.phase===&#x27;out&#x27;){st.v=OUT_V;st.x+=st.v*dt;dripping=true;if(st.x&gt;=OUT_END){st.x=OUT_END;st.phase=&#x27;pause&#x27;;st.t=0;setStatus();}}
    else if(st.phase===&#x27;pause&#x27;){st.v=0;st.t+=dt;if(st.t&gt;1.2){st.phase=&#x27;back&#x27;;setStatus();}}
    else if(st.phase===&#x27;back&#x27;){st.v=-BACK_V;st.x+=st.v*dt;if(st.x&lt;=0){st.x=0;st.phase=&#x27;dock&#x27;;st.t=0;setStatus();}}
    else if(st.phase===&#x27;dock&#x27;){st.v=0;st.t+=dt;charging=true;if(st.t&gt;3.2){st.phase=&#x27;out&#x27;;setStatus();}}
  } else st.v=0;
  robot.position.x=st.x;
  if(st.phase===&#x27;out&#x27; &amp;&amp; playing) trailEnd=Math.max(trailEnd,st.x-.34);
  updateTrail();

  trackOffset+=st.v*dt; updateTracks();
  wheels.forEach(w=&gt;{w.m.rotation.z-=st.v*dt/w.r;});
  rollerSpin.rotation.z-=st.v*dt/.055;

  const pulse=.5+.5*Math.sin(clock.elapsedTime*4);
  const col=charging?0xE8833A:0x3FB5A8;
  M.status.color.setHex(col); M.status.emissive.setHex(col); M.status.emissiveIntensity=charging?.8+pulse*1.6:1.6;
  dockLight.emissiveIntensity=charging?.4+pulse*2:.15;
  dockScreen.emissiveIntensity=charging?.6+pulse*.8:.35;

  if(dripping &amp;&amp; ex&lt;.05){
    dropTimer+=dt;
    while(dropTimer&gt;.03){dropTimer-=.03;
      const e=emitters[(Math.random()*emitters.length)|0]; e.getWorldPosition(emitW);
      const d=drops[dropIdx++%drops.length]; d.position.copy(emitW); d.position.y-=.012; d.userData.v=0; d.visible=true;}
  }
  drops.forEach(d=&gt;{if(!d.visible)return;d.userData.v+=3.5*dt;d.position.y-=d.userData.v*dt;if(d.position.y&lt;.004)d.visible=false;});

  ex+=((exploded?1:0)-ex)*Math.min(1,dt*(reduceMotion?60:5));
  Object.keys(EX).forEach(k=&gt;{const g=parts[k],o=EX[k],b=g.userData.base;g.position.set(b.x+o[0]*ex,b.y+o[1]*ex,b.z+o[2]*ex);});

  const dx=robot.position.x-prevX; prevX=robot.position.x;
